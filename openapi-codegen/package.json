{
  "name": "openapi-client-codegen-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Generate JavaScript and TypeScript API clients from OpenAPI specifications.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/generate.mjs validate",
    "generate:javascript": "node scripts/generate.mjs javascript",
    "generate:typescript": "node scripts/generate.mjs typescript",
    "generate:all": "node scripts/generate.mjs all"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.15.3"
  },
  "engines": {
    "node": ">=20"
  }
}
